{
  "name": "ether",
  "version": "1.0.0",
  "description": "A WebGL engine for premium Astro sites, built on three.js: persistent-canvas scene router, GPU quality tiers, Lenis + ScrollTrigger bridge, bloom + dither composer, extruded 3D type, and a live tweaks panel.",
  "license": "MIT",
  "author": "Jonathan Beck",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JonathanBeck1/ether.git"
  },
  "homepage": "https://github.com/JonathanBeck1/ether#readme",
  "keywords": [
    "three.js",
    "webgl",
    "astro",
    "gsap",
    "scrolltrigger",
    "lenis",
    "postprocessing",
    "glsl"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./postfx": "./src/postfx/index.ts",
    "./scroll": "./src/scroll/index.ts",
    "./shaders": "./src/shaders/index.ts",
    "./shaders/*.glsl": "./src/shaders/*.glsl",
    "./text": "./src/text/index.ts",
    "./text/msdf": "./src/text/msdf/index.ts",
    "./quality": "./src/quality/index.ts",
    "./astro": "./src/astro/index.ts",
    "./vanilla": "./src/vanilla/index.ts",
    "./primitives": "./src/primitives/index.ts",
    "./interactions": "./src/interactions/index.ts",
    "./loaders": "./src/loaders/index.ts",
    "./dev": "./src/dev/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/prepare-publish.mjs",
    "test:dist": "tsc -p tsconfig.dist.json && npm pack ./dist --dry-run",
    "test:e2e:dist": "ETHER_DIST=1 node tests/e2e/run.mjs"
  },
  "peerDependencies": {
    "detect-gpu": "^5.0.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.0",
    "opentype.js": "^1.3.0",
    "postprocessing": "^6.39.0",
    "three": "^0.184.0",
    "troika-three-text": "^0.52.0"
  },
  "peerDependenciesMeta": {
    "lenis": {
      "optional": true
    },
    "gsap": {
      "optional": true
    },
    "detect-gpu": {
      "optional": true
    },
    "opentype.js": {
      "optional": true
    },
    "troika-three-text": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/opentype.js": "^1.3.10",
    "@types/three": "^0.184.0",
    "detect-gpu": "^5.0.70",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "opentype.js": "^1.3.4",
    "playwright": "^1.60.0",
    "postprocessing": "^6.39.1",
    "three": "^0.184.0",
    "troika-three-text": "^0.52.5",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
